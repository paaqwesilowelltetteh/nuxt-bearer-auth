{
  "name": "nuxt-bearer-auth",
  "version": "0.1.7",
  "description": "Reusable Nuxt authentication module for bearer-token APIs with Redis sessions and CSRF protection.",
  "type": "module",
  "license": "MIT",
  "author": "Enoch Tetteh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paaqwesilowelltetteh/nuxt-bearer-auth.git"
  },
  "homepage": "https://github.com/paaqwesilowelltetteh/nuxt-bearer-auth#readme",
  "bugs": {
    "url": "https://github.com/paaqwesilowelltetteh/nuxt-bearer-auth/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "auth",
    "authentication",
    "bearer-token",
    "redis",
    "csrf",
    "laravel"
  ],
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/utils/authorization.d.ts",
      "import": "./dist/runtime/server/utils/authorization.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build --stub && nuxi prepare",
    "prepack": "nuxt-module-build build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "defu": "^6.1.4",
    "ofetch": "^1.4.1",
    "redis": "^5.11.0"
  },
  "peerDependencies": {
    "nuxt": "^3.12.0 || ^4.0.0",
    "nuxt-csurf": "^1.6.5"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.12.0",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.12.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "nuxt": "^3.12.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.0"
  },
  "packageManager": "npm@10.0.0"
}
